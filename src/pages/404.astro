---
import Layout from '../layouts/Layout.astro';
---
<Layout
        title="Page not found"
        description="This page doesn't exist."
        noindex={true}
>
    <div class="py-12">
        <p class="text-sm font-mono text-neutral-400">404</p>
        <h1 class="text-2xl font-bold tracking-tight mt-2">Page not found</h1>
        <p class="mt-4 text-neutral-600">
            Whatever you were looking for isn't here; might've moved, or never existed, who knows?
        </p>

        <div class="mt-8 flex gap-4 text-sm">
            <a href="/" class="text-blue-600 hover:underline">← Home</a>
            <a href="/projects" class="text-blue-600 hover:underline">Projects</a>
            <a href="/blog" class="text-blue-600 hover:underline">Blog</a>
        </div>
    </div>
</Layout>