---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = allProjects.filter((p) => p.data.featured);
const rest = allProjects.filter((p) => !p.data.featured);
---
<Layout title="Projects" description="...">
    <h1 class="text-2xl font-bold tracking-tight">Projects</h1>

    {featured.length > 0 && (
            <ul class="mt-8 space-y-8">
                {featured.map((project) => (
                        <li class="border-l-2 border-neutral-900 pl-4">
                            <a href={`/projects/${project.id}`} class="text-lg font-medium hover:underline">
                                {project.data.title}
                            </a>
                            <p class="text-neutral-600 mt-1">{project.data.description}</p>
                            <p class="text-sm text-neutral-400 mt-1">{project.data.stack.join(' · ')}</p>
                        </li>
                ))}
            </ul>
    )}

    {rest.length > 0 && (
            <>
                <h2 class="mt-12 text-sm font-semibold uppercase tracking-wide text-neutral-500">
                    More projects
                </h2>
                <ul class="mt-4 space-y-6">
                    {rest.map((project) => (
                            <li>
                                <a href={`/projects/${project.id}`} class="font-medium hover:underline">
                                    {project.data.title}
                                </a>
                                <p class="text-neutral-600 text-sm mt-1">{project.data.description}</p>
                            </li>
                    ))}
                </ul>
            </>
    )}
</Layout>