---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout
        title={project.data.title}
        description={project.data.description}
        type="article"
        publishDate={project.data.date.toISOString()}
>
    <a href="/projects" class="text-sm text-neutral-500 hover:underline">← All projects</a>
    <h1 class="text-2xl font-bold tracking-tight mt-2">{project.data.title}</h1>
    <p class="text-sm text-neutral-400 mt-1">{project.data.stack.join(' · ')}</p>
    {project.data.repository && (
            <a href={project.data.repository} class="text-sm text-blue-600 hover:underline mt-1 mr-5 inline-block">
                View repository →
            </a>
    )}
    {project.data.website && (
            <a href={project.data.website} class="text-sm text-blue-600 hover:underline mt-1 inline-block">
                View website →
            </a>
    )}

    <article class="prose prose-neutral mt-8 max-w-none">
        <Content />
    </article>
</Layout>