---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: string; // ISO date
	noindex?: boolean;
}

const {
	title,
	description,
	image = '/og-default.png',
	type = 'website',
	publishDate,
	noindex = false,
} = Astro.props;


const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Aron Kylebäck',
	url: Astro.site?.toString(),
	jobTitle: 'Software Student',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Skövde',
		addressCountry: 'SE',
	},
	sameAs: [
		"https://github.com/Collbrothers/",
		"https://se.linkedin.com/in/aron-kyleback-896747205",
		"https://www.instagram.com/aronkyleback/"
	],
};
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="icon" type="image/ico" href="/favicon.ico" />

	<title>{title} · Aron Kylebäck</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />
	<link rel="preconnect" href="https://umami.aronkyleback.com" />

	<meta property="og:type" content={type} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:title" content={`${title} · Aron Kylebäck`} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImageURL} />
	<meta property="og:locale" content="en_US" />
	{type === 'article' && publishDate && (
		<meta property="article:published_time" content={publishDate} />
	)}
	{import.meta.env.PROD && (
		<script defer src="https://umami.aronkyleback.com/script.js" data-website-id="2b00582d-3629-4190-8b64-ee6b42af9e0e"></script>
	)}

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`${title} · Aron Kylebäck`} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageURL} />

	<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

	<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
	<link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body class="bg-white text-neutral-900 antialiased">
<header class="max-w-3xl mx-auto px-6 pt-8 flex items-center justify-between">
	<a href="/" class="font-semibold tracking-tight">Aron Kylebäck</a>
	<nav class="flex gap-6 text-sm">
		<a href="/projects" class="hover:underline">Projects</a>
		<a href="/about" class="hover:underline">About</a>
		<a href="/blog" class="hover:underline">Blog</a>
		<a href="/contact" class="hover:underline">Contact</a>
	</nav>
</header>

<main class="max-w-3xl mx-auto px-6 py-12">
	<slot />
</main>

<footer class="max-w-3xl mx-auto px-6 pb-12 text-sm text-neutral-500">
	© {new Date().getFullYear()} Aron Kylebäck
</footer>
</body>
</html>
